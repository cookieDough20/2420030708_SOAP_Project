# ============================================================
# Smart Food Donation & Redistribution Platform — root .gitignore
# Covers all three ecosystems: Java/Maven backend, Python AI
# service, and the React/Vite frontend, plus IDE/OS noise.
# ============================================================

# ---------- Secrets / local env ----------
.env
.env.*
!.env.example
*.env.local

# ---------- Java / Maven (backend/*) ----------
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar

# Eclipse / STS project + workspace metadata
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache
.metadata/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ---------- Python (fastapi-ai-service) ----------
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node / React (frontend) ----------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.log
