# ========================================
# FastAPI AI Service - Environment Config
# ========================================

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Model configuration
MODEL_PATH=model/trained_model.pkl
MODEL_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# CORS - Allow Spring Boot AI Orchestrator / API Gateway
ALLOWED_ORIGINS=http://localhost:8087,http://localhost:8080
